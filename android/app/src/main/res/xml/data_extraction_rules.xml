<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device transfer (plan §10.9, D-24).
     Everything is included (the database lives in app_flutter/) except the
     safety backups and set-aside broken database files: they belong to this
     install only (plan §10.8). The cache folder is never backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="safety/" />
        <exclude domain="file" path="recovery/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="safety/" />
        <exclude domain="file" path="recovery/" />
    </device-transfer>
</data-extraction-rules>
