{
  // Run ▸ pick one. Both build "Planyar Dev", which has its own data.
  // The real app ("Planyar") is never run from here: `flutter run` uninstalls
  // an app (deleting its data) whenever an install fails, e.g. for an older
  // version than the phone has. Install it with `adb install -r` instead
  // (docs/RELEASE.md), which just fails safely.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Planyar Dev (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--flavor", "dev"]
    },
    {
      "name": "Planyar Dev (release, for speed checks)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "args": ["--flavor", "dev"]
    }
  ]
}
